# Settings for full mode (npm start). Copy this file to .env and fill it in.
# Demo mode (npm run demo) needs none of these.

# Supabase project: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API key. Each uploaded file or paste is one GPT-4.1 request.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# Signs session cookies. Use at least 32 random characters, for example the
# output of: openssl rand -base64 32
JWT_SECRET=

# Public URL of the app. Supabase sends people here after they confirm their
# email, so also add it under Authentication > URL Configuration > Redirect URLs.
# APP_URL=http://localhost:3000

# PORT=3000

# Extraction quotas, counted per UTC day: per user, and for all users combined.
# DAILY_EXTRACTION_LIMIT=20
# GLOBAL_DAILY_EXTRACTION_LIMIT=300

# Number of reverse proxies in front of the app (set to 1 automatically on Render).
# TRUST_PROXY=1
